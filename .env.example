# ---------- Shared ----------
NODE_ENV=development

# ---------- Database (PostgreSQL) ----------
# docker compose exposes postgres on host port 5444 to avoid clashing with other local instances.
DATABASE_URL=postgresql://spaceflow:spaceflow@localhost:5444/spaceflow?schema=public
# Separate isolated database used by integration tests (created automatically by `pnpm --filter @spaceflow/api test:setup`).
TEST_DATABASE_URL=postgresql://spaceflow:spaceflow@localhost:5444/spaceflow_test?schema=public

# ---------- API ----------
API_PORT=4000
API_BASE_URL=http://localhost:4000
WEB_ORIGIN=http://localhost:5173
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-characters-long
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-characters-long
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=14
COOKIE_SECURE=false
# Where uploaded floor plans / GLB models are stored (local disk adapter)
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=25
LOG_LEVEL=info
# Background job scheduler (reminders, auto-release, status transitions)
JOBS_ENABLED=true
JOBS_INTERVAL_SECONDS=30
# Optional Redis (caching + SSE fan-out across multiple API instances). Leave empty to run without Redis.
REDIS_URL=
# Error monitoring (Sentry-compatible DSN). Leave empty to disable.
SENTRY_DSN=
# Guest mode: "Continue as guest" creates a private sandbox organisation with demo data (purged after GUEST_SANDBOX_TTL_HOURS).
GUEST_MODE_ENABLED=true
GUEST_SANDBOX_TTL_HOURS=24

# ---------- Seed ----------
# Only used by `pnpm db:seed` in development. Never set these in production.
SEED_ADMIN_EMAIL=admin@spaceflow.local
SEED_ADMIN_PASSWORD=Admin123!
SEED_USER_PASSWORD=Password123!

# ---------- Integrations (all optional; adapters report "not configured" until filled) ----------
# Email (SMTP). When empty, emails are written to the API log (LogEmailProvider).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=SpaceFlow <no-reply@spaceflow.local>
# Enterprise SSO (OpenID Connect). When empty, local email/password auth is used.
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://localhost:4000/api/v1/auth/sso/callback
# Microsoft 365 / Graph (Outlook Calendar + Teams)
MS_GRAPH_TENANT_ID=
MS_GRAPH_CLIENT_ID=
MS_GRAPH_CLIENT_SECRET=
# Google Calendar (service account JSON path)
GOOGLE_CALENDAR_CREDENTIALS_PATH=

# ---------- Web (Vite reads only VITE_* variables) ----------
VITE_API_URL=http://localhost:4000
