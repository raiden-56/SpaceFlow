{
  "name": "@spaceflow/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/server.ts",
    "build": "prisma generate && tsc --noEmit && node scripts/build.mjs",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:setup": "tsx scripts/setup-test-db.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "prisma migrate reset --force --skip-seed && tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "openapi:export": "tsx scripts/export-openapi.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "@spaceflow/shared": "workspace:*",
    "cookie-parser": "1.4.7",
    "cors": "2.8.6",
    "dayjs": "1.11.23",
    "dotenv": "18.0.9",
    "express": "5.3.0",
    "express-rate-limit": "8.7.2",
    "helmet": "8.3.0",
    "jose": "6.2.14",
    "multer": "2.5.0",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "prisma": "6.19.3",
    "qrcode": "1.5.4",
    "swagger-ui-express": "5.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/cookie-parser": "1.4.10",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/multer": "2.3.0",
    "@types/node": "26.6.6",
    "@types/qrcode": "1.5.6",
    "@types/supertest": "7.2.1",
    "@types/swagger-ui-express": "4.1.8",
    "esbuild": "0.28.2",
    "pino-pretty": "13.2.0",
    "supertest": "7.3.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  }
}
